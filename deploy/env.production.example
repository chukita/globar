# Copiar a la raíz del repo en la VM: cp deploy/env.production.example .env
# Luego reemplazar COMPLETAR_* y contraseñas.

# --- Docker Compose / Caddy ---
PUBLIC_HOST=glob.ar

# --- Base de datos (misma clave en POSTGRES_PASSWORD y en DATABASE_URL) ---
POSTGRES_DB=globar
POSTGRES_USER=globar
POSTGRES_PASSWORD=COMPLETAR_CLAVE_POSTGRES_SEGURA
DATABASE_URL=postgres://globar:COMPLETAR_CLAVE_POSTGRES_SEGURA@db:5432/globar

# --- NextAuth ---
# Generar con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=COMPLETAR_CADENA_SECRETA_MINIMO_32_CARACTERES

# Login con Google (usado en /login) — Google Cloud Console → OAuth Client.
# Redirect URI a autorizar: https://glob.ar/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login de superadmin (/admin/login) — solo contraseña, no ligado a ningún
# usuario. Generar el hash con: npx tsx -e "import bcrypt from 'bcryptjs'; bcrypt.hash(process.argv[1], 12).then(console.log)" -- 'la-clave-elegida'
SUPERADMIN_PASSWORD_HASH=

# --- Webhook de pagos (productos digitales: agendaonline, nume, etc.) ---
# Header esperado: x-webhook-secret
WEBHOOK_SECRET=COMPLETAR_CADENA_SECRETA

# --- Uploads (facturas de revendedores) ---
# Opcional: por defecto se guardan en /app/uploads dentro del contenedor
# (volumen "uploads" persistente, ver docker-compose.prod.yml).
# UPLOAD_DIR=/app/uploads

# --- Backups de la base (servicio db_backup en docker-compose.prod.yml) ---
# Rotación de los dumps diarios en ~/globar/backups (opcional; estos son los defaults).
# BACKUP_KEEP_DAYS=14
# BACKUP_KEEP_WEEKS=8
# BACKUP_KEEP_MONTHS=6
